# ─── RTSP Source ──────────────────────────────────────────────────────────────
# RTSP URL của camera (có thể chứa credentials)
DEMO_RTSP=rtsp://user:password@host:port/path

# ─── MediaMTX ─────────────────────────────────────────────────────────────────
MEDIAMTX_HOST=localhost
MEDIAMTX_API_PORT=9997
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_PLAYBACK_PORT=9996
MEDIAMTX_HLS_PORT=8888

# ─── DVR ──────────────────────────────────────────────────────────────────────
# Thời gian tối đa có thể xem lại (giây).
# Tối đa 5 phút (300 giây). Chunks cũ hơn sẽ bị xóa tự động.
DVR_WINDOW_SECONDS=300

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ─── Frontend → Backend (docker-compose tự override, không cần sửa) ──────────
BACKEND_URL=http://localhost:3001
